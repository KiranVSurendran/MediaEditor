<Window x:Class="MediaToolbox.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Toolbox" Width="1536" Height="960" MinWidth="1100" MinHeight="700"
        Background="{DynamicResource PageBrush}" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="WindowDrop" DragOver="WindowDragOver">
  <Window.Resources>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,11"/><Setter Property="Margin" Value="0,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource ButtonBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="2"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/><Setter Property="Padding" Value="9,8"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="SelectionBrush" Value="#4081B8B0"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,6"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" Margin="10,0,31,0"/>
        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"/>
        <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
        <Popup x:Name="Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Toggle}" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, ElementName=ComboBorder}"><ScrollViewer MaxHeight="300" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
        </Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ComboBorder" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="#071313"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="Slider"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
    <!-- Main navigation -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="19,20,16,18">
          <StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}"><TextBlock Text="▶" Foreground="#071313" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,1,0,0" VerticalAlignment="Center"><TextBlock Text="MEDIA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="TOOLBOX" FontSize="15" FontWeight="Bold"/></StackPanel></StackPanel>
          <TextBlock Text="A calm workspace for everyday media edits." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,13,3,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,15"><Border Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="2,2,2,12"/><TextBlock Text="MORE TOOLS" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="9,4"/><Button Style="{StaticResource ToolButton}" Content="◌  Rotate" Tag="Rotate" Click="ComingSoonClick"/><Button Style="{StaticResource ToolButton}" Content="▦  Resize" Tag="Resize" Click="ComingSoonClick"/><Button Style="{StaticResource ToolButton}" Content="✦  Filters" Tag="Filters" Click="ComingSoonClick"/><Button Style="{StaticResource ToolButton}" Content="T  Titles" Tag="Titles" Click="ComingSoonClick"/><Button Content="☼  Switch theme" Click="ThemeClick" Margin="0,12,0,0"/><TextBlock Text="FFmpeg · Windows" Foreground="{DynamicResource MutedBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,11,0,0"/></StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,0">
          <TextBlock Text="TOOLS" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="9,4,0,8"/>
          <Button x:Name="ExtractNav" Style="{StaticResource ToolButton}" Content="♫  Extract Audio" Tag="Extract Audio" Click="ToolClick"/>
          <Button x:Name="TrimAudioNav" Style="{StaticResource ToolButton}" Content="◖  Trim Audio" Tag="Trim Audio" Click="ToolClick"/>
          <Button x:Name="TrimVideoNav" Style="{StaticResource ToolButton}" Content="✂  Trim Video" Tag="Trim Video" Click="ToolClick"/>
          <Button x:Name="CropNav" Style="{StaticResource ToolButton}" Content="▣  Crop Frame" Tag="Crop Frame" Click="ToolClick"/>
          <Button x:Name="JoinNav" Style="{StaticResource ToolButton}" Content="⇢  Join Videos" Tag="Join Videos" Click="ToolClick"/>
        </StackPanel></ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Preview and timeline workspace -->
    <Grid Grid.Column="1" Margin="22,18,18,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left"><TextBlock x:Name="TitleText" Text="Trim Video" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Text="Choose a range visually, then export a clean clip." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="PROJECT" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="ProjectName" Text="Untitled edit" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"/></StackPanel>
      </DockPanel>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,12" AllowDrop="True" Drop="InputDrop" DragOver="WindowDragOver">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource ButtonBrush}" VerticalAlignment="Center"><TextBlock Text="＋" Foreground="{DynamicResource AccentBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBox x:Name="InputBox" Grid.Column="1" TextChanged="InputChanged" VerticalContentAlignment="Center" Margin="9,0,6,0" ToolTip="Drop a media file, or paste a path"/><Button x:Name="BrowseButton" Grid.Column="2" Content="Browse files" Click="BrowseClick" Margin="3,0"/><Button x:Name="OpenPlayerButton" Grid.Column="3" Content="Open in player ↗" Click="OpenPlayerClick" Margin="5,0,0,0"/></Grid>
      </Border>
      <Grid Grid.Row="2">
        <Border x:Name="PreviewWorkspace" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
          <Grid>
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaOpened="MediaOpened" MediaEnded="MediaEnded"/>
            <Canvas x:Name="CropCanvas" Background="Transparent" Visibility="Collapsed" MouseLeftButtonDown="CropMouseDown" MouseMove="CropMouseMove" MouseLeftButtonUp="CropMouseUp" SizeChanged="CropCanvasSizeChanged"><Rectangle x:Name="CropSelection" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Fill="#1835D7C2"/></Canvas>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="58" Height="58" CornerRadius="18" Background="{DynamicResource ButtonBrush}" HorizontalAlignment="Center"><TextBlock Text="▶" Foreground="{DynamicResource AccentBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Your preview will appear here" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,3"/><TextBlock Text="Drop a media file here or browse your files" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/><Button Content="Choose media" Click="BrowseClick" HorizontalAlignment="Center" Margin="0,13,0,0"/></StackPanel>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#A6141920" CornerRadius="6" Padding="8,5" Margin="5"><TextBlock x:Name="PreviewName" Text="PREVIEW" Foreground="#D8E0E7" FontSize="9" FontWeight="Bold"/></Border>
            <Button x:Name="PlayOverlayButton" Content="▶" Width="50" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" Click="PlayClick" Opacity="0.92"/>
          </Grid>
        </Border>
        <Border x:Name="QueueWorkspace" Style="{StaticResource Card}" Padding="17" Visibility="Collapsed">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,1,0,12"><StackPanel><TextBlock x:Name="QueueTitle" Text="Files to process" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="QueueHint" Text="Add media, then review each file before exporting." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="QueueCountText" DockPanel.Dock="Right" Text="0 files" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
            <ListBox x:Name="QueueList" Grid.Row="1" ItemsSource="{Binding Queue}" AllowDrop="True" PreviewMouseDown="QueueList_PreviewMouseDown" PreviewMouseMove="QueueMouseMove" Drop="QueueDrop">
              <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="9" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><Border Width="64" Height="48" CornerRadius="6" Background="{DynamicResource ButtonBrush}" ClipToBounds="True"><Grid><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/><TextBlock Text="♫" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding AudioIconVisibility}"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding TrackSelectorVisibility}"><TextBlock Text="AUDIO TRACK" Foreground="{DynamicResource MutedBrush}" FontWeight="Bold" FontSize="9" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding TrackOptions}" SelectedItem="{Binding SelectedTrack, Mode=TwoWay}" DisplayMemberPath="Label"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Grid.Row="2" Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><Button Content="＋ Add files" Click="BrowseClick"/><Button Content="Remove" Click="RemoveQueueClick"/><Button Content="↑" Click="MoveUpClick" ToolTip="Move earlier"/><Button Content="↓" Click="MoveDownClick" ToolTip="Move later"/></StackPanel><TextBlock x:Name="QueueSummaryText" DockPanel.Dock="Right" Text="" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
          </Grid>
        </Border>
      </Grid>

      <Border x:Name="TimelinePanel" Grid.Row="3" Style="{StaticResource Card}" Padding="13" Margin="0,12,0,0" Visibility="Visible">
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PlayButton" Content="▶" Width="38" Height="33" Click="PlayClick" Padding="0" FontSize="14" Background="{DynamicResource ButtonBrush}"/><TextBlock x:Name="TimeText" Grid.Column="1" Text="00:00:00 / 00:00:00" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,9,0"/><Slider x:Name="PositionSlider" Grid.Column="2" Minimum="0" Maximum="1" ValueChanged="PositionChanged" PreviewMouseDown="PositionMouseDown" PreviewMouseUp="PositionMouseUp" VerticalAlignment="Center" Margin="4,0"/><Button Grid.Column="3" Content="◖" Click="VolumeDownClick" Padding="8,6" ToolTip="Mute or restore volume"/><Slider x:Name="VolumeSlider" Grid.Column="4" Width="90" Minimum="0" Maximum="1" Value="0.7" ValueChanged="VolumeChanged" VerticalAlignment="Center" Margin="5,0,0,0"/></Grid>
          <Grid x:Name="TimelinePanelContent" Height="98" Margin="0,11,0,1" SizeChanged="TimelineSizeChanged" Background="{DynamicResource CanvasBrush}" ClipToBounds="True">
            <ItemsControl x:Name="ThumbnailStrip" IsHitTestVisible="False" Margin="2,2"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding}" Stretch="UniformToFill" Margin="1,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Image x:Name="WaveformImage" IsHitTestVisible="False" Stretch="Fill" Visibility="Collapsed" Margin="1,3"/>
            <Canvas x:Name="RangeCanvas" Background="Transparent" MouseLeftButtonDown="TimelineDown" MouseMove="TimelineMove" MouseLeftButtonUp="TimelineUp" SizeChanged="TimelineSizeChanged"><Rectangle x:Name="LeftMask" Fill="#A9000000"/><Rectangle x:Name="RightMask" Fill="#A9000000"/><Rectangle x:Name="SelectionOutline" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Fill="#182BD0C1"/><Border x:Name="StartHandle" Width="11" Height="93" Background="{DynamicResource AccentBrush}" CornerRadius="4,0,0,4" Cursor="SizeWE"/><Border x:Name="EndHandle" Width="11" Height="93" Background="{DynamicResource AccentBrush}" CornerRadius="0,4,4,0" Cursor="SizeWE"/><Border x:Name="Playhead" Width="2" Height="93" Background="White" IsHitTestVisible="False"/><Border x:Name="PlayheadDot" Width="9" Height="9" CornerRadius="5" Background="White" IsHitTestVisible="False"/></Canvas>
          </Grid>
          <DockPanel Margin="1,7,1,0"><TextBlock Text="IN" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="TimelineStart" Text="00:00:00" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="6,0,12,0"/><TextBlock Text="OUT" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="TimelineEnd" Text="00:00:00" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="6,0,0,0"/><TextBlock x:Name="SelectionDuration" DockPanel.Dock="Right" Text="Selected 00:00:00" Foreground="{DynamicResource TextBrush}" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
        </StackPanel>
      </Border>
      <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource MutedBrush}"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/><ProgressBar x:Name="ProgressBar" Width="170" Height="5" Maximum="100" Visibility="Collapsed" Margin="12,0,0,0"/><TextBlock x:Name="ProgressText" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel job" Click="CancelClick" Visibility="Collapsed"/><Button x:Name="ExportButton" DockPanel.Dock="Right" Content="Export trimmed video" Background="{DynamicResource AccentBrush}" Foreground="#071313" BorderBrush="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" Padding="20,11" Click="ExportClick"/>
      </DockPanel>
    </Grid>

    <!-- Context-aware settings -->
    <Border Grid.Column="2" Background="{DynamicResource InspectorBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,0,0,0" Padding="17,18,17,14">
      <DockPanel LastChildFill="True">
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel><TextBlock x:Name="InspectorTitle" Text="Trim settings" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="EDIT" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/></DockPanel>
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" Background="{DynamicResource ButtonBrush}" CornerRadius="7"><TextBlock Text="▶" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock x:Name="MediaFileName" Text="No media selected" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MediaMetadata" Text="Add a file to see details" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="2" Content="↗" Padding="7,5" Click="OpenPlayerClick" ToolTip="Open in default player"/></Grid></Border>
          <Border Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="0,17,0,13"/>
          <StackPanel x:Name="TrimSettingsPanel">
            <TextBlock Text="SELECTION" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold"/>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Start · hh:mm:ss" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="1,0,0,4"/><TextBox x:Name="StartBox" Text="00:00:00" TextChanged="RangeTextChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="End · hh:mm:ss" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="1,0,0,4"/><TextBox x:Name="EndBox" Text="00:00:00" TextChanged="RangeTextChanged"/></StackPanel></Grid>
            <DockPanel Margin="1,9,1,0"><TextBlock Text="Selected duration" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock x:Name="DurationText" Text="00:00:00" Foreground="{DynamicResource TextBrush}" FontSize="10" FontWeight="SemiBold" DockPanel.Dock="Right" Margin="7,0,0,0"/></DockPanel>
            <TextBlock Text="QUALITY" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,18,0,7"/><ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="ModeChanged"><ComboBoxItem Content="Fast · keep original encoding"/><ComboBoxItem Content="Precise · re-encode accurately"/></ComboBox>
            <Border x:Name="QualityNote" Background="{DynamicResource ButtonBrush}" CornerRadius="7" Padding="9" Margin="0,9,0,0"><TextBlock x:Name="QualityNoteText" Text="Fast mode keeps the original encoding. Video cuts may land on a nearby keyframe." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/></Border>
          </StackPanel>
          <StackPanel x:Name="CropSettingsPanel" Visibility="Collapsed">
            <TextBlock Text="CROP AREA · DISPLAYED PIXELS" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Drag the frame corners or enter exact even pixel values." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,9"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="X" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="CropXBox" Text="0" TextChanged="CropTextChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Y" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="CropYBox" Text="0" TextChanged="CropTextChanged"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="Width" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="CropWidthBox" Text="0" TextChanged="CropTextChanged"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Height" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,4"/><TextBox x:Name="CropHeightBox" Text="0" TextChanged="CropTextChanged"/></StackPanel></Grid>
            <TextBlock Text="ASPECT PRESET" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,14,0,6"/><ComboBox x:Name="CropPresetBox" SelectedIndex="0" SelectionChanged="CropPresetChanged"><ComboBoxItem Content="Free"/><ComboBoxItem Content="1:1 · Square"/><ComboBoxItem Content="9:16 · Portrait"/><ComboBoxItem Content="16:9 · Widescreen"/><ComboBoxItem Content="4:3 · Classic"/></ComboBox><TextBlock x:Name="CropDimensionHint" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="1,8,0,0"/>
          </StackPanel>
          <StackPanel x:Name="ExtractSettingsPanel" Visibility="Collapsed">
            <TextBlock Text="AUDIO OUTPUT" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Choose a format or keep each track's original encoding." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,9"/><ComboBox x:Name="AudioFormatBox" SelectedIndex="0"><ComboBoxItem Content="Auto · preserve track codec"/><ComboBoxItem Content="MP3"/><ComboBoxItem Content="WAV · uncompressed"/><ComboBoxItem Content="FLAC"/><ComboBoxItem Content="AAC · M4A"/><ComboBoxItem Content="Opus"/></ComboBox><Border Background="{DynamicResource ButtonBrush}" CornerRadius="7" Padding="10" Margin="0,12,0,0"><TextBlock Text="Choose All tracks or a specific track for each file in the queue. Missing track choices are reported; another track is never substituted." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/></Border>
          </StackPanel>
          <StackPanel x:Name="JoinSettingsPanel" Visibility="Collapsed">
            <TextBlock Text="JOIN MODE" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold"/><ComboBox x:Name="JoinModeBox" SelectedIndex="0" SelectionChanged="JoinModeChanged" Margin="0,7,0,0"><ComboBoxItem Content="Automatic · best available"/><ComboBoxItem Content="Fast Join · matching streams"/><ComboBoxItem Content="Convert &amp; Join · H.264 / AAC"/></ComboBox><Border Background="{DynamicResource ButtonBrush}" CornerRadius="7" Padding="10" Margin="0,10,0,0"><TextBlock x:Name="JoinCompatibilityText" Text="Add two or more clips to check whether their streams match." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/></Border><StackPanel x:Name="JoinConversionPanel" Visibility="Collapsed"><TextBlock Text="CONVERSION TARGET" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,16,0,7"/><TextBlock Text="First clip size and frame rate · H.264 · stereo AAC. Silent clips receive a silent audio track." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/></StackPanel>
          </StackPanel>
          <Border Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="0,18,0,14"/>
          <TextBlock Text="SAVE RESULT" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="File name" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="1,10,0,5"/><TextBox x:Name="OutputNameBox" Text="edited"/><TextBlock Text="Save in" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="1,10,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputFolderBox"/><Button Grid.Column="1" Content="Browse" Click="OutputFolderClick" Padding="9,7"/></Grid>
          <DockPanel x:Name="ContainerRow" Margin="0,12,0,0"><TextBlock Text="Video container" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><ComboBox x:Name="ContainerBox" DockPanel.Dock="Right" Width="112" SelectedIndex="0"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="MP4"/><ComboBoxItem Content="MKV"/></ComboBox></DockPanel>
          <TextBlock Text="Track format sets its matching audio extension." x:Name="AudioContainerHint" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0" Visibility="Collapsed"/>
        </StackPanel></ScrollViewer>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Border Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="0,0,0,11"/><DockPanel><TextBlock Text="SOURCE" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="SourceSizeText" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="10" DockPanel.Dock="Right" Margin="8,0,0,0"/></DockPanel><TextBlock Text="Your original files stay untouched." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/></StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
